# TEMPLATE, contains NO working credentials. Never commit a populated copy.
# Root-owned 0640, readable only by the unprivileged app group, outside releases.
# Protect the directory too. Obtain all values through the approved secret store.
RAILS_ENV=production
DATABASE_URL=REPLACE_WITH_PRIMARY_DATABASE_SECRET_REFERENCE
SECRET_KEY_BASE=REPLACE_WITH_EXISTING_APPLICATION_SECRET
GRADUATE_EMAIL_BASE_URL=REPLACE_WITH_INDEPENDENT_CANONICAL_HTTPS_ORIGIN
GRADUATE_EMAIL_CODE_KEY=REPLACE_WITH_DISTINCT_RANDOM_KEY_AT_LEAST_32_BYTES
GRADUATE_EMAIL_LIMIT_KEY=REPLACE_WITH_DISTINCT_RANDOM_KEY_AT_LEAST_32_BYTES
GRADUATE_EMAIL_FROM=REPLACE_WITH_APPROVED_CANONICAL_SENDER
GRADUATE_EMAIL_SMTP_ADDRESS=REPLACE_WITH_APPROVED_RELAY_HOST
GRADUATE_EMAIL_SMTP_PORT=REPLACE_WITH_APPROVED_PORT
GRADUATE_EMAIL_SMTP_TLS=starttls
GRADUATE_EMAIL_SMTP_AUTHENTICATION=REPLACE_WITH_APPROVED_AUTH_METHOD
GRADUATE_EMAIL_SMTP_USER_NAME=REPLACE_WITH_SECRET_STORE_USERNAME
GRADUATE_EMAIL_SMTP_PASSWORD=REPLACE_WITH_SECRET_STORE_PASSWORD
# Set only for an authorized operator command in a protected environment:
# GRADUATE_EMAIL_OPERATOR_ID=REPLACE_WITH_CURRENT_ACTIVE_ADMIN_OR_MANAGER_ID
