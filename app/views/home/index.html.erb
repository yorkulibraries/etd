<% title "Overview" %>
<% title_html do %>
	<h1 class="border-bottom mb-3">Overview</h1>
<% end %>

<div class="home fitted">

	<ul class="nav nav-tabs">
		<li class="nav-item">
			<%= active_link_to 'Open', root_path, active: /\A\/\z/, class:"nav-link" %>
		</li>
		<li class="nav-item">
			<%= active_link_to 'Under Review', root_path(which: Thesis::UNDER_REVIEW), active: /under_review/, class:"nav-link" %>
		</li>
		<li class="nav-item">
			<%= active_link_to 'Accepted', root_path(which: Thesis::ACCEPTED), active: /accepted/, class:"nav-link" %>
		</li>
		<li class="nav-item">
			<%= active_link_to 'Assigned to me', root_path(which: :mine), active: /mine/, class:"nav-link" %>
		</li>
		<% if can? :read, EmbargoRequest %>
			<li class="nav-item">
				<%= active_link_to root_path(which: 'embargo_requests'), active: /embargo_requests/, class: 'nav-link' do %>
					Embargo Requests
					<% if @pending_embargo_requests_count.to_i.positive? %>
						<span class="badge rounded-pill text-bg-danger"><%= @pending_embargo_requests_count %></span>
					<% end %>
				<% end %>
			</li>
		<% end %>
	</ul>
	<% if @which == 'embargo_requests' %>
		<%= render 'embargo_requests/queue' %>
	<% else %>
		<div id="theses">
			<% if @theses.size == 0 %>
				<p class="py-3">There are no <strong><%= @which.humanize.titleize %></strong> theses available right now.</p>
			<% end %>
			<% @theses.each do |thesis| %>
				<%= render partial: thesis %>
			<% end %>
		</div>
	<% end %>
	
</div>
