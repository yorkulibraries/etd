<section id="embargo-requests" class="embargo-request-history">
  <h4>Embargo request history</h4>

  <% if @embargo_requests.empty? %>
    <p>No embargo requests have been submitted for this thesis.</p>
  <% end %>

  <% @embargo_requests.each do |embargo_request| %>
    <article class="card mb-3" id="embargo-request-<%= embargo_request.id %>">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><%= embargo_request.request_type.humanize %> request</span>
        <span class="badge text-bg-secondary"><%= embargo_request.status.humanize %></span>
      </div>
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">Reason</dt>
          <dd class="col-sm-8"><%= embargo_request.reason_label %></dd>
          <dt class="col-sm-4">Rationale</dt>
          <dd class="col-sm-8"><%= embargo_request.rationale %></dd>
          <dt class="col-sm-4">Requested duration</dt>
          <dd class="col-sm-8"><%= pluralize(embargo_request.requested_duration_months, 'month') %></dd>
          <dt class="col-sm-4">Submitted</dt>
          <dd class="col-sm-8"><%= format(embargo_request.submitted_at) %></dd>

          <% if embargo_request.approved? %>
            <dt class="col-sm-4">Approved until</dt>
            <dd class="col-sm-8"><%= format(embargo_request.approved_until) %></dd>
          <% elsif embargo_request.declined? %>
            <dt class="col-sm-4">Decision notes</dt>
            <dd class="col-sm-8"><%= embargo_request.decision_notes %></dd>
          <% end %>

          <% if embargo_request.decided_at.present? %>
            <dt class="col-sm-4">Decided by</dt>
            <dd class="col-sm-8"><%= embargo_request.decided_by.name %> on <%= format(embargo_request.decided_at) %></dd>
          <% end %>
        </dl>

        <% embargo_request.documents.not_deleted.where(usage: :embargo_letter).each do |document| %>
          <%= link_to 'Download supervisor support letter',
                      download_student_thesis_document_path(@student, @thesis, document),
                      class: 'btn btn-outline-secondary btn-sm me-2' %>
        <% end %>

        <% if embargo_request.submitted? && can?(:approve, embargo_request) %>
          <div class="row mt-3">
            <div class="col-md-6 mb-3 mb-md-0">
              <%= form_with url: approve_student_thesis_embargo_request_path(@student, @thesis, embargo_request), method: :post do |form| %>
                <%= form.label :approved_until, 'Approve until' %>
                <%= form.date_field :approved_until,
                                    name: 'embargo_request[approved_until]',
                                    min: EmbargoRequest.toronto_today,
                                    max: EmbargoRequest.toronto_today + 3.years,
                                    required: true,
                                    class: 'form-control mb-2' %>
                <%= form.submit 'Approve request', class: 'btn btn-success',
                                data: { confirm: 'Approve this embargo request?' } %>
              <% end %>
            </div>
            <div class="col-md-6">
              <%= form_with url: decline_student_thesis_embargo_request_path(@student, @thesis, embargo_request), method: :post do |form| %>
                <%= form.label :decision_notes, 'Decline notes' %>
                <%= form.text_area :decision_notes,
                                   name: 'embargo_request[decision_notes]',
                                   required: true,
                                   class: 'form-control mb-2' %>
                <%= form.submit 'Decline request', class: 'btn btn-danger',
                                data: { confirm: 'Decline this embargo request?' } %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </article>
  <% end %>
</section>
