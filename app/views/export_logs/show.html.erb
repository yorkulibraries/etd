<% title "DSpace Export" %>
<%= link_to export_logs_path(status: @export_log.job_status) do %>
  &laquo; Back to list
<% end %>
<hr class="fitted"/>

<%= render "summary" %>

<div class="row">
  <div class="span5">
    <blockquote class="export_log">
      <small>User</small>
      <p><%= @export_log.creator.name %></p>
      <small>Published Date</small>
      <p><%= @export_log.published_date.strftime("%b %d, %Y") rescue nil %></p>
    </blockquote>

  </div>


  <div class="span4">
    <blockquote class="export_log">
      <small>Status</small>
      <p><%= @export_log.job_status.upcase %></p>
      <small>Total Theses</small>
      <p><%= @export_log.theses_count.to_i %></p>
      <small>Successful Count</small>
      <p><%= @export_log.successful_count.to_i %></p>
      <small>Failed Count</small>
      <p><%= @export_log.failed_count.to_i %></p>

      <% if @export_log.job_status == ExportLog::JOB_OPEN %>
        <small>Export Pending</small>
        <p>Export scheduled...
          <%= link_to @export_log, method: :delete, class: "red", data: { confirm: "Are you sure?" } do %>
            <i title="Cancel Export" class="fa fa-times-circle"></i> Cancel?
          <% end %>
         </p>
      <% elsif @export_log.job_status == ExportLog::JOB_CANCELLED %>
        <small>Export Cancelled</small>
        <p><%= @export_log.job_cancelled_at.in_time_zone.strftime("%b %d, %Y %l:%M %p") rescue nil %></p>
        <p><%= @export_log.job_cancelled_by.name rescue nil %></p>
      <% else %>
        <small>Export Started</small>
        <p><%= @export_log.job_started_at.in_time_zone.strftime("%b %d, %Y %l:%M %p") rescue nil %></p>
        <% if @export_log.job_completed_at %>
          <small>Export Finished</small>
          <p><%= @export_log.job_completed_at.in_time_zone.strftime("%b %d, %Y %l:%M %p") %></p>
        <% end %>
      <% end %>
    </blockquote>
  </div>
</div>


<hr/>
<% if @export_log.stale? || @export_log.never_started? %>
  <%= link_to @export_log, method: :delete, class: "red", data: { confirm: "Mark this stopped export as cancelled?" } do %>
    <i title="Cancel Export" class="fa fa-times-circle"></i> Clear this stopped export
  <% end %>
<% end %>
