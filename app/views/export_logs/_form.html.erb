<div class="modal fade" id="new_export_log" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">DSpace Export</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <%= simple_form_for @export_log, html: { remote: true } do |f| %>
        <div class="modal-body">
          <% if f.object.errors[:base].any? %>
            <div class="alert alert-danger" role="alert"><%= f.object.errors[:base].join(' ') %></div>
          <% end %>
          <% dates = publish_on_dates(1.year, ahead: 0.days) %>
          <%= f.input :published_date, collection: dates, include_blank: false,
                      selected: f.object.published_date&.iso8601 || dates.last&.last %>
          <p class="trivial">Every accepted thesis with this publish date, or an earlier one that is still
            waiting, is deposited to YorkSpace, gets its licences, and is marked published. Check the list on
            Review Accepted Theses first.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          <%= f.button :submit, "Queue Up Export", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>