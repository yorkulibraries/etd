<section class="mb-4" aria-labelledby="email-connection-heading">
  <h2 id="email-connection-heading" class="h4">Email sign-in</h2>
  <% if @email_connection %>
    <p class="text-break">Verified address: <%= @email_connection.normalized_address %></p>
    <% if @email_connection.source == "record" %>
      <p>Connected using an email address on the student record. Verified <%= time_tag @email_connection.verified_at %>.</p>
    <% else %>
      <p>Approved by <%= @email_connection.approved_by.name %>. Verified <%= time_tag @email_connection.verified_at %>.</p>
    <% end %>
    <p>Contact FGS to change or remove email access.</p>
  <% else %>
    <p>No email sign-in address is connected yet. Signing in with a code sent to an email address on the student record connects it. Contact FGS to connect a different address.</p>
  <% end %>
</section>
