<% title "Graduate account connections for #{@student.name}" %>

<p><%= link_to "Back to student record", student_path(@student) %></p>

<% can_manage = GraduateAuthentication.staff_authorized?(current_user) && !@student.blocked? %>
<% unless can_manage %>
  <div class="alert alert-warning" role="alert">Connections cannot be changed for a blocked student or without an active administrator or manager account.</div>
<% end %>

<section class="mb-4" aria-labelledby="staff-linked-accounts-heading">
  <h2 id="staff-linked-accounts-heading" class="h4">Linked accounts</h2>
  <% if @identities.any? %>
    <ul class="list-group">
      <% @identities.each do |identity| %>
        <%= render "identity", identity: identity, removal_path: can_manage ? student_graduate_connection_path(@student, identity) : nil %>
      <% end %>
    </ul>
  <% else %>
    <p>No graduate accounts are connected yet.</p>
  <% end %>
</section>

<% if can_manage %>
  <section class="card mb-4" aria-labelledby="invitation-heading">
    <div class="card-body">
      <h2 id="invitation-heading" class="h4">Create a connection invitation</h2>
      <p>First verify this student's identity through an approved Faculty of Graduate Studies process outside this app. Agree on the provider and a secure way to share the invitation.</p>
      <p>Matching an email address is not identity verification. Each invitation expires after 48 hours, can be used once, and replaces any earlier unused invitation. No email is sent by this app.</p>
      <% providers = GraduateAuthentication.enabled_providers %>
      <% if providers.any? %>
        <%= form_with url: student_graduate_invitations_path(@student), method: :post, local: true, data: { turbo: false } do %>
          <div class="mb-3">
            <%= label_tag :provider, "Account provider", class: "form-label" %>
            <%= select_tag :provider, options_for_select(providers.map { |provider| [GraduateAuthentication.label(provider), provider] }), required: true, class: "form-select" %>
          </div>
          <div class="form-check mb-3">
            <%= check_box_tag :identity_verified, "1", false, required: true, class: "form-check-input", data: { graduate_confirmation: true } %>
            <%= label_tag :identity_verified, "I verified this student's identity outside this app and agreed on this provider.", class: "form-check-label" %>
          </div>
          <%= submit_tag "Create invitation", class: "btn btn-primary" %>
        <% end %>
      <% else %>
        <p class="text-secondary mb-0">No account providers are enabled. Invitations are currently unavailable.</p>
      <% end %>
    </div>
  </section>
<% end %>
<%= render "confirmation_script" %>

<% if @invitations.any? %>
  <section aria-labelledby="recent-invitations-heading">
    <h2 id="recent-invitations-heading" class="h4">Recent invitations</h2>
    <ul class="list-group">
      <% @invitations.each do |invitation| %>
        <li class="list-group-item">
          <strong><%= GraduateAuthentication.label(invitation.provider) %></strong>
          <span class="d-block">
            <% if invitation.consumed_at %>
              Used
            <% elsif invitation.revoked_at %>
              Superseded
            <% elsif invitation.expires_at <= Time.current %>
              Expired
            <% else %>
              Active
            <% end %>
          </span>
          <span class="d-block">Expires <%= time_tag invitation.expires_at, invitation.expires_at.strftime("%B %-d, %Y at %H:%M %Z") %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= render "email_connection" %>
<% if can_manage && GraduateEmail::Control.enabled? && !@email_connection %>
  <section class="card mb-4" aria-labelledby="email-approval-heading">
    <div class="card-body">
      <h2 id="email-approval-heading" class="h4">Approve email sign-in</h2>
      <p>Verify this student's identity through the approved FGS process before choosing one individual sign-in address. Contact details below are reference information only and do not grant access.</p>
      <p class="text-break">Contact email: <%= @student.email %></p>
      <p class="text-break">External contact email: <%= @student.email_external %></p>
      <%= form_with url: student_graduate_email_invitations_path(@student), method: :post, local: true, data: { turbo: false } do %>
        <div class="mb-3">
          <%= label_tag :email_address, "Approved sign-in address", class: "form-label" %>
          <%= email_field_tag :address, nil, id: "email_address", maxlength: 254, required: true, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= label_tag :confirmed_address, "Confirm approved address", class: "form-label" %>
          <%= email_field_tag :confirmed_address, nil, maxlength: 254, required: true, class: "form-control" %>
        </div>
        <div class="form-check mb-3">
          <%= check_box_tag :identity_verified, "1", false, id: "email_identity_verified", required: true, class: "form-check-input", data: { graduate_confirmation: true } %>
          <%= label_tag :email_identity_verified, "I verified this student's identity through the approved FGS process and confirmed this individual recipient.", class: "form-check-label" %>
        </div>
        <%= submit_tag "Create email invitation", class: "btn btn-primary" %>
      <% end %>
    </div>
  </section>
<% end %>
<% if @email_approvals.any? %>
  <section aria-labelledby="email-invitations-heading">
    <h2 id="email-invitations-heading" class="h4">Email invitations</h2>
    <% @email_approvals.each do |approval| %>
      <div class="mb-3 text-break">
        <p><%= approval.normalized_address %>: <%= approval.consumed_at ? "Used" : approval.revoked_at ? "Canceled" : approval.expires_at <= Time.current ? "Expired" : "Pending" %></p>
        <% if can_manage && !approval.consumed_at && !approval.revoked_at && approval.expires_at > Time.current %>
          <%= button_to "Cancel email invitation", student_graduate_email_invitation_path(@student, approval), method: :delete, class: "btn btn-outline-danger", form: { data: { turbo: false } } %>
        <% end %>
      </div>
    <% end %>
  </section>
<% end %>
